<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>$(MSBuildThisFileDirectory)..\bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <!-- Copy executable binaries to unified root bin/$(Configuration)/ directory -->
  <Target Name="CopyToolToCommonBin" AfterTargets="Build" Condition="'$(OutputType)' == 'Exe' and '$(IsTestProject)' != 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildThisFileDirectory)..\bin\$(Configuration)\" SkipUnchangedFiles="true" />
  </Target>
</Project>
